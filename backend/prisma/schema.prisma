generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String
  phone            String?            @unique
  emailVerified    Boolean            @default(false)
  phoneVerified    Boolean            @default(false)
  twoFactorEnabled Boolean            @default(false)
  twoFactorSecret  String?
  status           String             @default("ACTIVE")
  demoModeEnabled  Boolean            @default(false)
  referralCode     String?            @unique @default(cuid())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
  deposits         Deposit[]
  devices          DeviceTracking[]
  kycDocuments     KycDocument[]
  loginHistory     LoginHistory[]
  notifications    Notification[]
  otps             OtpCode[]
  platformOrders   PlatformOrder[]
  holdings         PortfolioHolding[]
  profile          Profile?
  referredBy       Referral?          @relation("Referred")
  referralsMade    Referral[]         @relation("Referrer")
  refreshTokens    RefreshToken[]
  sessions         Session[]
  supportTickets   SupportTicket[]
  buyerTrades      Trade[]            @relation("BuyerUser")
  sellerTrades     Trade[]            @relation("SellerUser")
  tradingAccounts  TradingAccount[]
  roles            UserRole[]
  wallets          Wallet[]
  walletAddresses  WalletAddress[]
  withdrawals      Withdrawal[]

  @@index([email])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  key        String    @unique
  secret     String
  name       String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  location  String?
  isSuccess Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DeviceTracking {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String   @unique
  deviceModel  String?
  osVersion    String?
  appVersion   String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  type      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  country     String?
  city        String?
  address     String?
  postalCode  String?
  kycStatus   KycStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  nationalId  String?
  bio         String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycDocument {
  id              String    @id @default(uuid())
  userId          String
  documentType    String
  fileId          String
  status          KycStatus @default(PENDING)
  rejectionReason String?
  adminNotes      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Wallet {
  id            String        @id @default(uuid())
  userId        String
  currency      String        @db.VarChar(10)
  type          WalletType    @default(REAL)
  balance       Decimal       @default(0.0000) @db.Decimal(19, 4)
  isLocked      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  lockedBalance Decimal       @default(0.0000) @db.Decimal(19, 4)
  deposits      Deposit[]
  transactions  Transaction[]
  user          User          @relation(fields: [userId], references: [id])
  withdrawals   Withdrawal[]

  @@unique([userId, currency, type])
}

model Transaction {
  id            String            @id @default(uuid())
  reference     String            @unique
  walletId      String
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amount        Decimal           @db.Decimal(19, 4)
  currency      String            @db.VarChar(10)
  fee           Decimal           @default(0.0000) @db.Decimal(19, 4)
  netAmount     Decimal           @db.Decimal(19, 4)
  providerId    String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  ledgerEntries LedgerEntry[]
  wallet        Wallet            @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@index([createdAt])
}

model LedgerEntry {
  id            String      @id @default(uuid())
  transactionId String
  accountId     String
  direction     String
  amount        Decimal     @db.Decimal(19, 4)
  currency      String      @db.VarChar(10)
  description   String?
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([accountId])
  @@index([transactionId])
}

model PaymentProvider {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deposit {
  id            String        @id @default(uuid())
  userId        String
  walletId      String
  amount        Decimal       @db.Decimal(19, 4)
  currency      String        @db.VarChar(10)
  paymentMethod String
  reference     String?       @unique
  status        DepositStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  txHash        String?       @unique
  user          User          @relation(fields: [userId], references: [id])
  wallet        Wallet        @relation(fields: [walletId], references: [id])

  @@index([userId, status])
  @@index([walletId, status])
}

model Withdrawal {
  id               String           @id @default(uuid())
  userId           String
  walletId         String
  amount           Decimal          @db.Decimal(19, 4)
  currency         String           @db.VarChar(10)
  withdrawalMethod String
  destination      String
  note             String?
  status           WithdrawalStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  networkFee       Decimal?         @db.Decimal(19, 4)
  txHash           String?          @unique
  user             User             @relation(fields: [userId], references: [id])
  wallet           Wallet           @relation(fields: [walletId], references: [id])

  @@index([userId, status])
  @@index([walletId, status])
}

model TradingPair {
  id             String            @id @default(uuid())
  symbol         String            @unique
  baseAsset      String
  quoteAsset     String
  minOrderSize   Decimal           @default(0.01) @db.Decimal(19, 4)
  maxOrderSize   Decimal           @default(100.00) @db.Decimal(19, 4)
  tickSize       Decimal           @default(0.00001) @db.Decimal(19, 5)
  lotSize        Decimal           @default(1.00) @db.Decimal(19, 4)
  status         TradingPairStatus @default(ACTIVE)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  platformOrders PlatformOrder[]
  trades         Trade[]

  @@index([status])
  @@index([baseAsset])
  @@index([quoteAsset])
}

model PlatformOrder {
  id                String              @id @default(uuid())
  userId            String
  tradingPairId     String
  side              OrderSide
  type              OrderType
  status            PlatformOrderStatus @default(PENDING)
  quantity          Decimal             @db.Decimal(19, 4)
  filledQuantity    Decimal             @default(0.0000) @db.Decimal(19, 4)
  remainingQuantity Decimal             @db.Decimal(19, 4)
  price             Decimal?            @db.Decimal(19, 5)
  averagePrice      Decimal?            @db.Decimal(19, 5)
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tradingPair       TradingPair         @relation(fields: [tradingPairId], references: [id])
  user              User                @relation(fields: [userId], references: [id])
  buyTrades         Trade[]             @relation("BuyerOrder")
  sellTrades        Trade[]             @relation("SellerOrder")

  @@index([userId, status])
  @@index([tradingPairId, status])
  @@index([createdAt])
}

model PortfolioHolding {
  id              String     @id @default(uuid())
  userId          String
  asset           String
  type            WalletType @default(REAL)
  quantity        Decimal    @default(0.0000) @db.Decimal(19, 4)
  lockedQuantity  Decimal    @default(0.0000) @db.Decimal(19, 4)
  averageBuyPrice Decimal    @default(0.0000) @db.Decimal(19, 5)
  totalCost       Decimal    @default(0.0000) @db.Decimal(19, 5)
  realizedPnL     Decimal    @default(0.0000) @db.Decimal(19, 5)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id])

  @@unique([userId, asset, type])
  @@index([userId])
}

model Trade {
  id            String        @id @default(uuid())
  buyerOrderId  String
  sellerOrderId String
  buyerId       String
  sellerId      String
  tradingPairId String
  quantity      Decimal       @db.Decimal(19, 4)
  price         Decimal       @db.Decimal(19, 5)
  total         Decimal       @db.Decimal(19, 5)
  status        TradeStatus   @default(SETTLED)
  executionTime DateTime      @default(now())
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  buyer         User          @relation("BuyerUser", fields: [buyerId], references: [id])
  buyerOrder    PlatformOrder @relation("BuyerOrder", fields: [buyerOrderId], references: [id])
  seller        User          @relation("SellerUser", fields: [sellerId], references: [id])
  sellerOrder   PlatformOrder @relation("SellerOrder", fields: [sellerOrderId], references: [id])
  tradingPair   TradingPair   @relation(fields: [tradingPairId], references: [id])

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([tradingPairId, createdAt])
  @@index([buyerOrderId])
  @@index([sellerOrderId])
}

model TradingProvider {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradingAccount {
  id            String             @id @default(uuid())
  userId        String
  providerId    String
  accountNumber String             @unique
  type          TradingAccountType @default(LIVE)
  currency      String             @db.VarChar(10)
  balance       Decimal            @default(0.0000) @db.Decimal(19, 4)
  equity        Decimal            @default(0.0000) @db.Decimal(19, 4)
  margin        Decimal            @default(0.0000) @db.Decimal(19, 4)
  freeMargin    Decimal            @default(0.0000) @db.Decimal(19, 4)
  leverage      Int                @default(100)
  isArchived    Boolean            @default(false)
  name          String?
  accountClass  String             @default("STANDARD")
  server        String             @default("TradeCore-Real")
  isActive      Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  orders        Order[]
  positions     Position[]
  user          User               @relation(fields: [userId], references: [id])

  @@index([userId, type])
}

model Order {
  id               String         @id @default(uuid())
  tradingAccountId String
  ticket           String         @unique
  symbol           String
  type             OrderType
  side             OrderSide
  volume           Decimal        @db.Decimal(19, 4)
  openPrice        Decimal        @db.Decimal(19, 5)
  stopLoss         Decimal?       @db.Decimal(19, 5)
  takeProfit       Decimal?       @db.Decimal(19, 5)
  status           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id])

  @@index([tradingAccountId, status])
}

model Position {
  id               String         @id @default(uuid())
  tradingAccountId String
  ticket           String         @unique
  symbol           String
  side             OrderSide
  volume           Decimal        @db.Decimal(19, 4)
  openPrice        Decimal        @db.Decimal(19, 5)
  closePrice       Decimal?       @db.Decimal(19, 5)
  swap             Decimal        @default(0.0000) @db.Decimal(19, 4)
  commission       Decimal        @default(0.0000) @db.Decimal(19, 4)
  profit           Decimal        @default(0.0000) @db.Decimal(19, 4)
  status           PositionStatus @default(OPEN)
  openedAt         DateTime
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id])

  @@index([tradingAccountId, status])
  @@index([symbol])
}

model SupportTicket {
  id        String          @id @default(uuid())
  userId    String
  subject   String
  category  String
  status    TicketStatus    @default(OPEN)
  priority  String          @default("NORMAL")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  user      User            @relation(fields: [userId], references: [id])
  messages  TicketMessage[]

  @@index([userId, status])
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  senderId   String
  content    String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Referral {
  id           String   @id @default(uuid())
  referrerId   String
  referredId   String   @unique
  rewardAmount Decimal  @default(0.0000) @db.Decimal(19, 4)
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  referred     User     @relation("Referred", fields: [referredId], references: [id])
  referrer     User     @relation("Referrer", fields: [referrerId], references: [id])

  @@index([referrerId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model WebhookLog {
  id           String   @id @default(uuid())
  provider     String
  event        String
  payload      Json
  responseCode Int?
  isProcessed  Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model JobTracking {
  id          String    @id @default(uuid())
  jobName     String
  status      String
  error       String?
  startedAt   DateTime
  completedAt DateTime?
}

model FileMetadata {
  id           String   @id @default(uuid())
  bucket       String
  path         String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
}

model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model Network {
  id                    String                  @id @default(uuid())
  name                  String                  @unique
  symbol                String                  @unique
  chainId               Int?
  rpcUrl                String?
  explorerUrl           String?
  confirmationsRequired Int                     @default(1)
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  blockchainTx          BlockchainTransaction[]
  walletAddresses       WalletAddress[]
}

model WalletAddress {
  id                  String   @id @default(uuid())
  userId              String
  networkId           String
  address             String   @unique
  privateKeyEncrypted String
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  network             Network  @relation(fields: [networkId], references: [id])
  user                User     @relation(fields: [userId], references: [id])

  @@unique([userId, networkId])
}

model BlockchainTransaction {
  id            String   @id @default(uuid())
  networkId     String
  txHash        String   @unique
  fromAddress   String?
  toAddress     String
  amount        Decimal  @db.Decimal(19, 4)
  fee           Decimal? @db.Decimal(19, 4)
  confirmations Int      @default(0)
  status        String   @default("PENDING")
  type          String
  referenceId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  network       Network  @relation(fields: [networkId], references: [id])

  @@index([txHash])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTERNAL_TRANSFER
  FEE
  REBATE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TradingAccountType {
  LIVE
  DEMO
}

enum WalletType {
  REAL
  DEMO
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

enum OrderSide {
  BUY
  SELL
}

enum PositionStatus {
  OPEN
  CLOSED
  LIQUIDATED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TradeStatus {
  SETTLED
  FAILED
  CANCELLED
}

enum TradingPairStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlatformOrderStatus {
  PENDING
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  REJECTED
}
